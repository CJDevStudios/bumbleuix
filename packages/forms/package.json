{
    "name": "@cjdevstudios/bumbleuix-forms",
    "version": "0.1.0",
    "author": "CJ Development Studios",
    "contributors": [
        {
            "name": "CJ Development Studios"
        },
        {
            "name": "PrimeTek Informatics"
        }
    ],
    "description": "Forms utilities for BumbleVue",
    "keywords": ["forms", "validation", "utilities", "primevue", "primeuix", "bumblevue", "bumbleuix"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CJDevStudios/bumbleuix.git",
        "directory": "packages/forms"
    },
    "bugs": {
        "url": "https://github.com/CJDevStudios/bumbleuix/issues"
    },
    "exports": {
        "./*": {
            "types": "./dist/*/index.d.mts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": ["dist", "umd", "README.md", "LICENSE"],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "tsup",
        "build:dev:package": "tsup --watch",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@cjdevstudios/bumbleuix-utils": "workspace:^"
    },
    "devDependencies": {
        "joi": "^17.13.3",
        "superstruct": "^2.0.2",
        "valibot": "^0.42.1",
        "yup": "^1.4.0",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
