{
    "name": "@cjdevstudios/bumbleuix-motion",
    "version": "1.0.0-beta.2",
    "author": "CJ Development Studios",
    "contributors": [
        {
            "name": "CJ Development Studios"
        },
        {
            "name": "PrimeTek Informatics"
        }
    ],
    "description": "Motion utilities for PrimeUI Libraries",
    "keywords": ["motion", "animation", "transition", "composition utilities", "primevue", "primeuix", "bumblevue", "bumbleuix"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CJDevStudios/bumbleuix.git",
        "directory": "packages/motion"
    },
    "bugs": {
        "url": "https://github.com/CJDevStudios/bumbleuix/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "tsup",
        "build:dev:package": "tsup --watch",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@cjdevstudios/bumbleuix-utils": "workspace:^"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
