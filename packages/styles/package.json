{
    "name": "@cjdevstudios/bumbleuix-styles",
    "version": "2.0.3",
    "author": "CJ Development Studios",
    "contributors": [
        {
            "name": "CJ Development Studios"
        },
        {
            "name": "PrimeTek Informatics"
        }
    ],
    "description": "Styles utilities for BumbleVue",
    "keywords": ["styles", "css", "style utilities", "primevue", "primeuix", "bumblevue", "bumbleuix"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CJDevStudios/bumbleuix.git",
        "directory": "packages/styles"
    },
    "bugs": {
        "url": "https://github.com/CJDevStudios/bumbleuix/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "types": "./dist/types.d.mts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "pnpm run build:prebuild && tsup",
        "build:dev:package": "pnpm run build:prebuild && tsup --watch",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "type:check": "tsc --noEmit",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@cjdevstudios/bumbleuix-styled": "workspace:^"
    }
}
